# OS
.DS_Store

# Trained weights (safetensors): reproduced by the dt experiments
/models/

# Datasets (large binaries); keep the download script
data/*
!data/download-mnist.sh

# Python / uv
**/.venv/
.venv/
**/__pycache__/
*.py[cod]
*$py.class
.python-version
uv.lock
**/.uv/
*.egg-info/
.eggs/

# PDFs and other heavy docs
*.pdf

# Odin build artifacts / local binaries
*.o
*.obj
*.a
*.so
*.dylib
*.exe
*.dSYM/
# make builds into build/; plain `odin run <dir>` drops a binary named after the dir
/build/
/main
/regression
/mnist
/mnist_cnn
/tensor_ops
/metal
/loop
examples/*/*
!examples/*/*.odin
!examples/*/*.md
tests/*/*
!tests/*/*.odin
bench/**/main
!bench/**/main.odin

# Local asm / IR dumps from benches
**/study.s
**/study_ir/
**/probe_bin

# bench output
bench/odin_ref*.txt
